Proceso miniSistemas
	Definir nombre, correo, ciudad, programa Como Texto;
    Definir edad Como Entero;
    
    Escribir "Ingrese su nombre:";
    Leer nombre;
    Escribir "Ingrese su edad:";
    Leer edad;
    Escribir "Ingrese su correo electrónico:";
    Leer correo;
    Escribir "Ingrese su ciudad:";
    Leer ciudad;
    Escribir "Ingrese su programa:";
    Leer programa;
    
    Escribir "";
    Escribir "**************************************************";
    Escribir "*                 SISTEMA APRENDIZ               *";
    Escribir "**************************************************";
    Escribir "* Nombre:   ", nombre;
    Escribir "* Edad:     ", edad, " años";
    Escribir "* Correo:   ", correo;
    Escribir "* Ciudad:   ", ciudad;
    Escribir "* Programa: ", programa;
    Escribir "**************************************************";
FinProceso
