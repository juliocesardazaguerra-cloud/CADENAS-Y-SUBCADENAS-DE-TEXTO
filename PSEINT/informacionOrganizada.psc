Proceso informacionOrganizada
	Definir nombre, programa, ciudad Como Texto;
    Definir edad Como Entero;
    
    Escribir "Ingrese su nombre:";
    Leer nombre;
    Escribir "Ingrese su edad:";
    Leer edad;
    Escribir "Ingrese su programa de formación:";
    Leer programa;
    Escribir "Ingrese su ciudad:";
    Leer ciudad;
    
    // Impresión de la ficha con la plantilla
    Escribir "=================================";
    Escribir "       PERFIL DEL APRENDIZ       ";
    Escribir "=================================";
    Escribir "Nombre: ", nombre;
    Escribir "Edad: ", edad;
    Escribir "Programa: ", programa;
    Escribir "Ciudad: ", ciudad;
    Escribir "=================================";
	
FinProceso
