Proceso carnetAprendiz
	Definir nombre,documento,programa Como Caracter;
	Definir ficha Como Entero;
	
	Escribir "Registro de información para el carnet";
	Escribir "Nombre Completo:";
	Leer nombre;
	Escribir "Numero de documento:";
	Leer documento;
	Escribir "Nombre del programa:";
	Leer programa;
	Escribir "Numero de la ficha:";
	Leer ficha;
	
	Escribir "********************************";
	Escribir "Carnet del aprendiz";
	Escribir "Nombre: ",nombre;
	Escribir "Documento: ",documento;
	Escribir "Programa: ",programa;
	Escribir "Ficha: ",ficha;
	Escribir "********************************";
FinProceso
