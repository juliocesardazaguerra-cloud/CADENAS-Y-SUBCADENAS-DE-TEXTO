Proceso organizandoInformacion
	Definir nombre,programa,ciudad Como Caracter;
	Definir edad Como Entero;
	
	Escribir "Ingrese su nombre, por favor";
	Leer nombre;
	Escribir "Ingrese su edad, por favor";
	Leer edad;
	Escribir "Ingrese su programa, por favor";
	Leer programa;
	Escribir "Ingrese su ciudad, por favor";
	Leer ciudad;
	
	Escribir "************************************";
	Escribir nombre Sin Saltar;
	Escribir " | " Sin Saltar;
	Escribir edad Sin Saltar;
	Escribir " | " Sin Saltar;
	Escribir programa Sin Saltar;
	Escribir " | " Sin Saltar;
	Escribir Ciudad;
	
FinProceso
